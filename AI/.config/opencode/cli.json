{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system",
    "mode": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show",
    "image_preview": true,
    "permissions": "autoaccept",
    "verbosity": "high"
  },
  "animations": true,
  "tabs": {
    "mode": "off",
    "layout": "vertical",
    "indicators": "numbers"
  },
  "attention": {
    "sound": true,
    "notifications": true
  },
  "terminal": {
    "copy": "select"
  }
}
