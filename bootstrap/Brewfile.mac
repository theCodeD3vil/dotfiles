# macOS-only half of the Brewfile: casks, App Store apps, VS Code extensions, and
# the formulae/taps with no Linux build. Run after Brewfile, on a Mac only.
#   brew bundle --file bootstrap/Brewfile.mac
tap "altimor/tap", trusted: true
tap "darrylmorley/whatcable", trusted: true
tap "devdotfast/tap", trusted: true
tap "dopplerhq/doppler", trusted: true
tap "felixkratz/formulae", "https://github.com/FelixKratz/homebrew-formulae", trusted: true
tap "fif7y/tap", trusted: true
tap "kamillobinski/thock", trusted: true
tap "srimanachanta/tap", trusted: true
tap "st0012/cctop", trusted: true
tap "wunderlandmedia/tap", trusted: true
# Mac App Store command-line interface
brew "mas"
# Polyglot runtime manager (asdf rust clone)
# Only used for tuist (~/Projects/Cork).
brew "mise"
# Deep clean and optimize your Mac
brew "mole"
# Command-line USB-C cable diagnostics
brew "darrylmorley/whatcable/whatcable-cli", trusted: true
# Custom macOS statusbar with shell plugin, interaction and graph support
brew "felixkratz/formulae/sketchybar"
# Menu bar tool to limit maximum charging percentage
cask "aldente"
# Coding agent and development environment
cask "amp-app"
# Android SDK component
cask "android-platform-tools"
# Agent orchestration platform
cask "antigravity"
# Live wallpaper app
cask "backdrop"
# Tool to flash OS images to SD cards & USB drives
cask "balenaetcher"
# Screen capturing and editing tool
cask "bettershot"
# Screen recording software
cask "cap"
# Native GUI for Homebrew casks
cask "caskhub"
# OpenAI's official ChatGPT desktop app
cask "chatgpt"
# Anthropic's official Claude AI desktop app
cask "claude"
# Image, video and clipboard optimiser
cask "clop"
# OpenAI's coding agent that runs in your terminal
cask "codex"
# Brings the power of Copilot coding agent directly to your terminal
cask "copilot-cli"
# Voice and text chat software
cask "discord"
# Window peeking utility app
cask "dockdoor"
# App to build and share containerised applications and microservices
cask "docker-desktop"
# Native AI agent interface to build, manage, and ship software by Factory
cask "factory"
# Collaborative team software
cask "figma"
# Font installers for Figma.app
cask "figma-agent"
cask "font-sketchybar-app-font"
# Terminal emulator that uses platform-native UI and GPU acceleration
cask "ghostty"
# Finance terminal
cask "gloomberb"
# Web browser
cask "google-chrome"
# Client for the Google Drive storage service
cask "google-drive"
# Native desktop AI assistant from Google
cask "google-gemini"
# Grammarly for desktop
cask "grammarly-desktop"
# Speech to text application
cask "handy"
# Reduce token usage for Claude Code and Codex
cask "headroom"
# Chromium-based web browser
cask "helium-browser"
# Testing client for REST, GraphQL, and HTTP APIs
cask "httpie-desktop"
# Convert your caps lock key or any of your modifier keys to the hyper key
cask "hyperkey"
# Terminal emulator as alternative to Apple's Terminal app
cask "iterm2"
# Terminal optimised for AI coding
cask "kaku"
# Mechanical keyboard sounds for every keystroke
cask "keyecho"
# Launchpad alternative
cask "launchos"
# Web browser
cask "librewolf"
# App to manage software development and track bugs
cask "linear"
# Menu bar app for running local LLMs
cask "llama-app"
# Open-source cross-platform alternative to AirDrop
cask "localsend"
# Open-source firewall to block unknown outgoing connections
cask "lulu"
# Clipboard manager
cask "maccy"
# Deep clean, analyze, and optimize app
cask "mole-app"
# Reverse proxy, secure introspectable tunnels to localhost
cask "ngrok"
# VPN client for secure internet access and private browsing
cask "nordvpn"
# Instant actions for selected text
cask "openclip"
# Open-source transport simulation game
cask "openttd"
# AI usage tracker for Cursor, Claude Code, Codex, Copilot and more
cask "openusage"
# Utility to uninstall apps and remove leftover files from old/uninstalled apps
cask "pearcleaner"
# Desktop client for Proton Pass
cask "proton-pass"
# VPN client focusing on security
cask "protonvpn"
# Network monitor and firewall
cask "radio-silence"
# All-in-one bookmark manager
cask "raindropio"
# Control your tools with a few keystrokes
cask "raycast"
# Move and resize windows using keyboard shortcuts or snap areas
cask "rectangle"
# Collection of apps available by subscription
cask "setapp"
# Graphical client for Git version control
cask "sourcetree"
# Dictation and transcription app with AI-powered editing
cask "spokenly"
# Music streaming service
cask "spotify"
# Video game digital distribution service
cask "steam"
# Settings for SteelSeries peripherals and accessories
cask "steelseries-gg"
# Monitor token usage, costs, and limits across AI coding tools
cask "token-monitor"
# Charting and social-networking for investment traders
cask "tradingview"
# Email client with collaborative notes
cask "twobird"
# Open-source code editor
cask "visual-studio-code"
# Multimedia player
cask "vlc"
# Menu bar toolkit with keep-awake, system monitor and volume mixer
cask "vorssaint"
# Rust-based terminal
cask "warp"
# GPU-accelerated cross-platform terminal emulator and multiplexer
cask "wezterm@nightly"
# Menu bar app for USB-C cable diagnostics
cask "whatcable"
# Native desktop client for WhatsApp
cask "whatsapp"
# Minimalist markdown editor
cask "altimor/tap/flo-state", trusted: true
# Review agent-written code changes
cask "devdotfast/tap/whiteboard", trusted: true
# The official Doppler CLI for managing your secrets
cask "dopplerhq/doppler/doppler", trusted: true
# Calm menu bar (formerly pelmet)
cask "fif7y/tap/dimble", trusted: true
# Thock your mac keyboard
cask "kamillobinski/thock/thock", trusted: true
# Battery management and dashboard for Apple Silicon
cask "srimanachanta/tap/stasis", trusted: true
# Monitor AI coding sessions from the macOS menu bar
cask "st0012/cctop/cctop", trusted: true
# Menu bar app that detects keyboard shortcut conflicts
cask "wunderlandmedia/tap/hotkeyclash", trusted: true
