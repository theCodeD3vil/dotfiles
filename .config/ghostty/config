# ~/.config/ghostty/config

font-family = Cartograph CF
font-size = 16
# Nerd Font icons come from CaskaydiaCove instead of Ghostty's built-in symbols.
font-codepoint-map = U+E000-U+F8FF,U+F0000-U+FFFFF=CaskaydiaCove Nerd Font Mono
# Narrower cells make the tmux window pills' rounded caps (U+E0B4) look rounder.
# Off while testing bigger prompt icons.
# adjust-cell-width = -6%

window-padding-x = 16
window-padding-y = 16

macos-option-as-alt = true

# Optional transparency
background-opacity = 0.7
background-blur-radius = 20

# Vira Theme - Deepforest (vira-theme-for-terminals/ghostty/Vira-Theme-Deepforest.conf)
background = #111816
foreground = #CAE5D5

cursor-color = #FFCC00
cursor-text = #111816

selection-background = #4B7253
selection-foreground = #CAE5D5

palette = 0=#3B544D
palette = 1=#f07178
palette = 2=#C3E88D
palette = 3=#FFCB6B
palette = 4=#6FA0DE
palette = 5=#A68DCD
palette = 6=#74C9DE
palette = 7=#CAE5D5

palette = 8=#3B544D
palette = 9=#f07178
palette = 10=#C3E88D
palette = 11=#FFCB6B
palette = 12=#6FA0DE
palette = 13=#A68DCD
