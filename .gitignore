.DS_Store

**/**/.DS_Store

# atuin's installer receipt: it bakes in this machine's home path
.config/atuin/atuin-receipt.json

# worktrunk keeps per-machine state (command approvals, lock files) next to its config
.config/worktrunk/approvals.toml
.config/worktrunk/*.lock

# Kaku and Warp write sessions, caches, AI keys and downloaded binaries next to their
# config. On a fresh machine stow links the whole directory, so track only the config.
.config/kaku/*
!.config/kaku/kaku.lua
.warp/*
!.warp/settings.toml

# Test suites are kept locally but are not part of the dotfiles repository.
**/test/
**/tests/
**/__tests__/
**/spec/
**/specs/
**/*.test.*
**/*.spec.*
**/test_*
**/*_test.*
