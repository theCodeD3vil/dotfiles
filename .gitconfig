[user]
	name = Cod3vil
	email = micheal.nji@newvcreatives.com

# Client- or machine-specific settings (per-folder identities and the like) live
# in an untracked ~/.gitconfig.local. Git skips the include when it is missing.
[include]
    path = ~/.gitconfig.local
[credential "https://github.com"]
	helper = 
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !gh auth git-credential

[safe]
	directory = *
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = main
[core]
    pager = delta
	excludesfile = /Users/michaelnji/.gitignore_global

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true

    # Vira Deepforest: syntax colors come from the bat theme of the same name,
    # diff backgrounds are the palette's red and green blended into the terminal
    # background (14% for lines, 30% for the changed words).
    syntax-theme = Vira Deepforest
    minus-style = syntax "#302424"
    minus-emph-style = syntax "#543333"
    plus-style = syntax "#2a3527"
    plus-emph-style = syntax "#46563a"
    line-numbers-zero-style = "#64746b"
    line-numbers-minus-style = "#f07178"
    line-numbers-plus-style = "#C3E88D"
    file-style = "#80CBC4" bold
    file-decoration-style = "#80CBC4" ul
    hunk-header-style = file line-number syntax
    hunk-header-decoration-style = "#283834" box


    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path = 
[mergetool "sourcetree"]
	cmd = /Users/michaelnji/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
